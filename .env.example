TOPSTEP_USERNAME=your_topstepx_username
TOPSTEP_API_KEY=your_api_key
TOPSTEP_BASE_URL=https://api.topstepx.com

# Optional — if omitted, the first tradeable active account is used
# TOPSTEP_ACCOUNT_ID=30060167

# Optional — if omitted, active MNQ front month is auto-selected
# TOPSTEP_CONTRACT_ID=CON.F.US.MNQ.Z26
TOPSTEP_SYMBOL_SEARCH=MNQ
# Practice/sim accounts usually need false
TOPSTEP_CONTRACT_LIVE=false
TOPSTEP_RTC_URL=https://rtc.topstepx.com/hubs/market

# Place broker orders when the strategy fires in Live mode
TOPSTEP_ENABLE_ORDERS=true

# Champion strategy (optional overrides)
# STOP_TICKS=240
# LOTS=2
# TP1_TICKS=160
# MOVE_BE=true
# OPP_PULL_TICKS=-100
# NO_FRIDAY=true
# ATR_MULT=0.75
# ATR_LOOKBACK_DAYS=5
# TP1_MIN_TICKS=60
# TP1_MAX_TICKS=400
